# ==========================================
# SPIDER NEWS RADAR - ENVIRONMENT VARIABLES
# ==========================================

# 1. System 1: Gatekeeper Engine (Laya RL Agent hoặc Decision 3.0, hoặc Mock)
# ENGINE: auto | laya | d3 | mock (mặc định: auto - tự động nhận diện container đang bật trên port 8000)
# Người dùng bật/tắt thủ công qua Docker Desktop hoặc Docker CLI.
SYSTEM1_ENGINE=auto
SYSTEM1_BASE_URL=http://127.0.0.1:8000
SYSTEM1_TIMEOUT_SECONDS=5.0
SYSTEM1_FALLBACK_TO_MOCK=true

# Tương thích ngược:
LAYA_BASE_URL=http://127.0.0.1:8000
LAYA_TIMEOUT_SECONDS=5.0

# 2. System 2: LLM Synthesizer (Gemini, OpenRouter, DeepSeek, Local Ollama/vLLM)
LLM_PROVIDER=gemini
# LLM_PROVIDER có thể là: gemini | openrouter | deepseek | custom
LLM_API_KEY=your_api_key_here
LLM_MODEL_NAME=gemini-2.5-flash
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# 3. Backend Server & Database
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8001
SQLITE_DB_PATH=backend/data/spider_radar.db

# 4. Scraper Settings (Paywall 4 tang: JSON-LD -> r.jina.ai -> friendly browser UA -> print/AMP/cache)
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0 Safari/537.36
JINA_READER_BASE=https://r.jina.ai
SCRAPE_INTERVAL_SECONDS=300
